rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidAdminConfig(data) {
      return data.keys().hasAll(['instagramEnabled']) &&
             data.instagramEnabled is bool &&
             (
               !('instagramState' in data.keys()) ||
               (data.instagramState is string && data.instagramState.size() <= 1048576) // Max 1MB
             ) &&
             (
               !('updatedAt' in data.keys()) ||
               (data.updatedAt is number)
             );
    }

    match /config/admin {
      allow read: if true; // We need the server and clients to know if it's enabled. Wait, clients shouldn't read the state.
      // Wait! The state has cookies! We cannot let clients read it!
      // Only the server needs the state. The server uses Admin SDK, which bypasses security rules!
      // So no one needs to read it except the admin to check if it's enabled.
      // Wait, let's just make it only readable and writable by admins.
      // Server will read it using Firebase Admin SDK (which bypasses rules).
      // Oh, wait, the client doesn't need to read the state. The client just calls an API.
      // If we use Firebase Admin SDK on the server, we don't even need allow read for the public!
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidAdminConfig(incoming()) && incoming().keys().size() <= 3;
      allow update: if isSignedIn() && isValidAdminConfig(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['instagramEnabled', 'instagramState', 'updatedAt']);
    }
  }
}
