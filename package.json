  "scripts": {
    "dev": "tsx server.ts",
    "build": "node scripts/download-yt-dlp.js && node scripts/download-xtractor.cjs && vite build && node scripts/fix_html.cjs && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && node scripts/notify-deploy.cjs",
