    "@vitejs/plugin-react": "^5.0.4",
    "@vreden/youtube_scraper": "^1.2.9",
    "adm-zip": "^0.5.17",
    "apify-client": "^2.23.4",
    "canvas-confetti": "^1.9.4",
    "cheerio": "^1.2.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "igdl.js": "^1.0.0",
    "igdown-scrapper": "^2.0.0",
    "instagram-dl": "^0.2.0",
    "instagram-url-direct": "^2.0.7",
    "instagram-url-downloader": "^1.1.0",
    "lucide-react": "^0.546.0",
